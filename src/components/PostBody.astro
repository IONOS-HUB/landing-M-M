---
// Cuerpo de un artículo: texto, índice y CTA lateral. Se usa en la página del
// artículo y en el lector dentro de la landing.
import Icon from './Icon.astro';
import { slugify, type Post } from '../data/posts';
import { waLink } from '../data/site';

interface Props {
  post: Post;
  headingTag?: 'h2' | 'h4';
  idPrefix?: string;
}
const { post, headingTag = 'h2', idPrefix = '' } = Astro.props;
const H = headingTag;
const hid = (text: string) => `${idPrefix}${slugify(text)}`;
const toc = post.body.filter((b): b is { h2: string } => 'h2' in b).map((b) => ({ id: hid(b.h2), text: b.h2 }));
const consultMsg = `Hola, leí la guía «${post.title}» y quisiera una consulta sobre mi caso.`;
---
<div class="article-grid">
  <div class="prose">
    {post.body.map((b) =>
      'h2' in b ? <H id={hid(b.h2)}>{b.h2}</H>
      : 'p' in b ? <p>{b.p}</p>
      : 'ul' in b ? <ul>{b.ul.map((li) => <li>{li}</li>)}</ul>
      : <aside class="prose-note"><p>{b.note}</p></aside>
    )}
    <p class="prose-disclaimer">
      Este artículo es información general y no reemplaza la asesoría de un abogado para su caso concreto.
    </p>
  </div>

  <aside class="article-aside">
    <div class="aside-sticky">
      {toc.length > 0 && (
        <nav class="toc" aria-label="En este artículo">
          <p class="toc-title">En este artículo</p>
          <ol>
            {toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}
          </ol>
        </nav>
      )}
      <div class="aside-cta">
        <p class="aside-cta-title">¿Está pasando por esto?</p>
        <p>Le explicamos qué opciones tiene en su caso.</p>
        <a class="btn btn-solid" href={waLink(consultMsg)} target="_blank" rel="noopener">
          <Icon name="whatsapp" class="ico" />
          <span>Consultar por WhatsApp</span>
        </a>
        <a class="link-thread link-dark" href="/#consulta" data-close-to="consulta">Agendar una consulta <Icon name="arrow" class="ico" /></a>
      </div>
    </div>
  </aside>
</div>
