---
import Icon from './Icon.astro';
import { site, areas } from '../data/site';
---
<form
  class="cform"
  data-cform
  data-endpoint={site.formEndpoint}
  data-wa={site.whatsapp}
  novalidate
  aria-describedby="cform-privacy"
>
  <div class="weft weft-thin cform-weft" aria-hidden="true"></div>
  <div class="cform-body">
    <div class="cform-row cform-2">
      <div class="field">
        <label for="cf-nombre">Nombre y apellido</label>
        <input id="cf-nombre" name="nombre" type="text" autocomplete="name" required aria-describedby="cf-nombre-err" />
        <p class="field-err" id="cf-nombre-err" data-err-for="nombre"></p>
      </div>
      <div class="field">
        <label for="cf-telefono">Tu WhatsApp</label>
        <input id="cf-telefono" name="telefono" type="tel" inputmode="tel" autocomplete="tel" placeholder="099 123 4567" required aria-describedby="cf-telefono-err" />
        <p class="field-err" id="cf-telefono-err" data-err-for="telefono"></p>
      </div>
    </div>

    <div class="cform-row cform-2">
      <div class="field">
        <label for="cf-area">¿Sobre qué es tu caso?</label>
        <select id="cf-area" name="area" required aria-describedby="cf-area-err">
          <option value="">Elige una opción</option>
          {areas.map((a) => <option>{a.name}</option>)}
          <option>No estoy seguro</option>
        </select>
        <p class="field-err" id="cf-area-err" data-err-for="area"></p>
      </div>
      <div class="field">
        <label for="cf-canton">Cantón o ciudad</label>
        <select id="cf-canton" name="canton" required aria-describedby="cf-canton-err">
          <option value="">Elige una opción</option>
          {site.cantons.map((c) => <option>{c}</option>)}
          <option>Otro</option>
        </select>
        <p class="field-err" id="cf-canton-err" data-err-for="canton"></p>
      </div>
    </div>

    <div class="field">
      <label for="cf-mensaje">Cuéntanos brevemente qué está pasando</label>
      <textarea id="cf-mensaje" name="mensaje" rows="5" maxlength="800" required aria-describedby="cf-mensaje-hint cf-mensaje-err" placeholder="Por ejemplo: me llegó una citación y no sé qué plazo tengo."></textarea>
      <div class="field-foot">
        <p class="field-err" id="cf-mensaje-err" data-err-for="mensaje"></p>
        <p class="field-hint" id="cf-mensaje-hint">No incluyas datos sensibles del caso; los vemos en la consulta. <span data-count>0</span>/800</p>
      </div>
    </div>

    <!-- Trampa anti-spam: las personas no la ven; los robots la llenan. -->
    <div class="cform-hp" aria-hidden="true">
      <label for="cf-empresa">Empresa</label>
      <input id="cf-empresa" name="empresa" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="field">
      <label class="check">
        <input type="checkbox" name="acepto" required />
        <span>Autorizo al estudio a contactarme para responder mi consulta (<a href="#privacidad">privacidad</a>).</span>
      </label>
      <p class="field-err" data-err-for="acepto"></p>
    </div>

    <div class="cform-submit">
      <button class="btn btn-solid btn-lg" type="submit" data-submit>
        <span data-label>Enviar mi consulta</span>
        <Icon name="arrow" class="ico" />
      </button>
      <p class="cform-privacy" id="cform-privacy">Discreción absoluta: tu información es confidencial y solo la usamos para responderte.</p>
    </div>

    <div class="cform-status" role="status" aria-live="polite" data-status hidden></div>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-cform]');
  if (form) {
    const endpoint = form.dataset.endpoint || '';
    const wa = form.dataset.wa || '';
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-label]')!;
    const count = form.querySelector<HTMLElement>('[data-count]');
    const mensaje = form.querySelector<HTMLTextAreaElement>('textarea[name="mensaje"]')!;

    mensaje.addEventListener('input', () => {
      if (count) count.textContent = String(mensaje.value.length);
    });

    const setErr = (name: string, msg: string) => {
      const el = form.querySelector<HTMLElement>(`[data-err-for="${name}"]`);
      if (el) el.textContent = msg;
      form.querySelectorAll<HTMLInputElement>(`[name="${name}"]`).forEach((i) =>
        msg ? i.setAttribute('aria-invalid', 'true') : i.removeAttribute('aria-invalid')
      );
    };

    const validate = () => {
      const d = new FormData(form);
      const nombre = String(d.get('nombre') || '').trim();
      const tel = String(d.get('telefono') || '').replace(/[^\d+]/g, '');
      const msg = String(d.get('mensaje') || '').trim();
      const errs: Record<string, string> = {
        nombre: nombre.length < 3 ? 'Escribe tu nombre para saber cómo dirigirnos a ti.' : '',
        telefono: tel.replace('+', '').length < 9 ? 'Escribe un número de 9 o 10 dígitos, por ejemplo 0991234567.' : '',
        area: d.get('area') ? '' : 'Elige el tipo de caso, o «No estoy seguro» si tienes dudas.',
        canton: d.get('canton') ? '' : 'Elige tu cantón, u «Otro» si vives en otra ciudad.',
        mensaje: msg.length < 10 ? 'Cuéntanos tu caso en al menos una frase.' : '',
        acepto: d.get('acepto') ? '' : 'Necesitamos tu autorización para poder responderte.',
      };
      Object.entries(errs).forEach(([k, v]) => setErr(k, v));
      const first = Object.keys(errs).find((k) => errs[k]);
      if (first) form.querySelector<HTMLElement>(`[name="${first}"]`)?.focus();
      return {
        ok: !first,
        nombre,
        tel,
        msg,
        area: String(d.get('area') || ''),
        canton: String(d.get('canton') || ''),
        trampa: String(d.get('empresa') || ''),
      };
    };

    form.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.getAttribute('aria-invalid')) setErr(t.name, '');
    });

    const show = (kind: 'ok' | 'error', html: string) => {
      status.hidden = false;
      status.className = `cform-status is-${kind}`;
      status.innerHTML = html;
    };

    // Fila para Google Sheets: una clave por columna, en el orden de la hoja.
    const toRow = (v: ReturnType<typeof validate>) => {
      const q = new URLSearchParams(location.search);
      return {
        fecha: new Date().toISOString(),
        nombre: v.nombre,
        whatsapp: v.tel,
        canton: v.canton,
        asunto: v.area,
        mensaje: v.msg,
        autoriza_contacto: 'Sí',
        origen: 'Formulario web',
        pagina: location.origin + location.pathname,
        utm_source: q.get('utm_source') || '',
        utm_medium: q.get('utm_medium') || '',
        utm_campaign: q.get('utm_campaign') || '',
      };
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.hidden = true;
      const v = validate();
      if (!v.ok) return;

      const text =
        `Hola, vengo de la página web. Soy ${v.nombre}, de ${v.canton}.\n` +
        `Tipo de asunto: ${v.area}.\n\n${v.msg}\n\nMi WhatsApp: ${v.tel}.`;
      const waUrl = `https://wa.me/${wa}?text=${encodeURIComponent(text)}`;
      const done = () => {
        form.reset();
        if (count) count.textContent = '0';
        show('ok', '<strong>Recibimos tu consulta.</strong> Te escribiremos a tu WhatsApp en horario de atención.');
      };

      // Un robot llenó la trampa: se finge el envío y no se guarda nada.
      if (v.trampa) return done();

      if (!endpoint) {
        window.open(waUrl, '_blank', 'noopener');
        show('ok', '<strong>Abrimos WhatsApp con tu mensaje listo.</strong> Solo toca «Enviar». Si no se abrió, <a href="' + waUrl + '" target="_blank" rel="noopener">ábrelo aquí</a>.');
        return;
      }

      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      label.textContent = 'Enviando…';
      try {
        // Formato de formulario (no JSON) para evitar la petición previa de CORS;
        // n8n lo recibe igual en $json.body con las mismas claves.
        const res = await fetch(endpoint, {
          method: 'POST',
          body: new URLSearchParams(toRow(v)),
        });
        if (!res.ok) throw new Error(String(res.status));
        done();
      } catch {
        show('error', '<strong>No pudimos enviar el formulario.</strong> Revisa tu conexión e inténtalo de nuevo, o <a href="' + waUrl + '" target="_blank" rel="noopener">envíanos el mismo mensaje por WhatsApp</a>.');
      } finally {
        submit.disabled = false;
        submit.removeAttribute('aria-busy');
        label.textContent = 'Enviar mi consulta';
      }
    });
  }
</script>
