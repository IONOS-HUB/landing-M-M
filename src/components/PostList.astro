---
// Lista de guías con filtro por área. Cada enlace lleva data-open para que la
// landing pueda abrir el artículo dentro de la misma vista.
import Icon from './Icon.astro';
import { sortedPosts, formatDate, readingTime } from '../data/posts';

interface Props {
  headingTag?: 'h2' | 'h3';
}
const { headingTag = 'h2' } = Astro.props;
const H = headingTag;
const [lead, ...rest] = sortedPosts;
const counts = {
  Todas: sortedPosts.length,
  Familia: sortedPosts.filter((p) => p.category === 'Familia').length,
  Civil: sortedPosts.filter((p) => p.category === 'Civil').length,
};
---
<div class="postlist" data-postlist>
  <div class="filters" role="group" aria-label="Filtrar guías por área">
    {Object.entries(counts).map(([cat, n], i) => (
      <button class="chip-btn" type="button" data-filter={cat} aria-pressed={i === 0 ? 'true' : 'false'}>
        {cat} <span class="chip-count">{n}</span>
      </button>
    ))}
  </div>

  <article class="post-feature" data-cat={lead.category}>
    <div class="post-feature-weft weft" aria-hidden="true"></div>
    <div class="post-feature-body">
      <H><a href={`/blog/${lead.slug}/`} data-open={lead.slug}>{lead.title}</a></H>
      <p class="post-excerpt">{lead.excerpt}</p>
      <p class="post-meta post-meta-line">
        <span class="post-cat" data-cat={lead.category}>{lead.category}</span>
        <span>Lo más reciente · {formatDate(lead.date)} · {readingTime(lead)} min de lectura</span>
      </p>
      <a class="link-thread link-dark" href={`/blog/${lead.slug}/`} data-open={lead.slug} aria-hidden="true" tabindex="-1">
        Leer la guía <Icon name="arrow" class="ico" />
      </a>
    </div>
  </article>

  <ul class="post-list">
    {rest.map((post) => (
      <li class="post-item" data-cat={post.category}>
        <p class="post-cat" data-cat={post.category}>{post.category}</p>
        <div>
          <H><a href={`/blog/${post.slug}/`} data-open={post.slug}>{post.title}</a></H>
          <p class="post-excerpt">{post.excerpt}</p>
        </div>
        <p class="post-meta post-meta-split"><span>{formatDate(post.date)}</span> <span>{readingTime(post)} min de lectura</span></p>
      </li>
    ))}
  </ul>
  <p class="post-empty" data-empty hidden>No hay guías en esta área todavía.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-postlist]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = root.querySelectorAll<HTMLElement>('.post-feature, .post-item');
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const cat = btn.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        let shown = 0;
        items.forEach((el) => {
          const show = cat === 'Todas' || el.dataset.cat === cat;
          el.hidden = !show;
          if (show) shown++;
        });
        if (empty) empty.hidden = shown > 0;
      })
    );
  });
</script>
