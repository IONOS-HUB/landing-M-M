---
// Isotipo M&M (doble M con balanza), trazado desde logos/ISOTIPOS.
interface Props {
  variant?: 'color' | 'light';
  class?: string;
  title?: string;
}
const { variant = 'color', class: className, title } = Astro.props;
const uid = `iso-${Math.random().toString(36).slice(2, 8)}`;
const fill = (n: number) => (variant === 'light' ? 'currentColor' : `url(#${uid}-${n})`);
---
<svg
  class={className}
  viewBox="100 225 880 680"
  xmlns="http://www.w3.org/2000/svg"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
>
  {variant === 'color' && (
    <defs>
      <linearGradient id={`${uid}-1`} x1="106.33" y1="0" x2="535.33" y2="0" gradientUnits="userSpaceOnUse">
        <stop offset=".63" stop-color="#093287" /><stop offset="1" stop-color="#3abefd" />
      </linearGradient>
      <linearGradient id={`${uid}-2`} x1="420.25" y1="0" x2="973.67" y2="0" gradientUnits="userSpaceOnUse">
        <stop offset=".19" stop-color="#093287" /><stop offset="1" stop-color="#3abefd" />
      </linearGradient>
      <linearGradient id={`${uid}-3`} x1="553.33" y1="0" x2="673.03" y2="0" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#0082ff" /><stop offset="1" stop-color="#3abefd" />
      </linearGradient>
      <linearGradient id={`${uid}-4`} x1="420.25" y1="0" x2="671.03" y2="0" gradientUnits="userSpaceOnUse">
        <stop offset=".31" stop-color="#093287" /><stop offset="1" stop-color="#3abefd" />
      </linearGradient>
    </defs>
  )}
  <polygon fill={fill(1)} points="535.33 505.29 416.33 231.29 344.58 231.29 106.33 784.29 179.84 784.29 382.33 293.29 505.33 574.29 535.33 505.29" />
  <polygon fill={fill(2)} points="729.6 231.29 657.6 231.29 420.25 784.29 489.19 784.29 693.33 294.29 913.26 784.29 973.67 784.29 729.6 231.29" />
  <polygon fill={fill(3)} points="553.33 641.29 612.18 783.29 673.03 783.29 581.33 573.29 553.33 641.29" />
  <path fill={fill(4)} d="m671.03,794.43h-250.78c141.92,122.14,250.78,0,250.78,0Z" />
</svg>
