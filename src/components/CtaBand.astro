---
import Icon from './Icon.astro';
import { waLink } from '../data/site';

interface Props {
  title: string;
  text?: string;
  message?: string;
}
const { title, text, message } = Astro.props;
---
<aside class="cta-band indigo" aria-label="Contacto">
  <div class="wrap cta-band-grid">
    <div>
      <p class="cta-band-title">{title}</p>
      {text && <p class="cta-band-text">{text}</p>}
    </div>
    <div class="cta-band-actions">
      <a class="btn btn-wa btn-lg" href={waLink(message)} target="_blank" rel="noopener">
        <Icon name="whatsapp" class="ico" />
        <span>Escríbenos por WhatsApp</span>
      </a>
      <a class="link-thread" href="/#consulta">Enviar mi consulta <Icon name="arrow" class="ico" /></a>
    </div>
  </div>
</aside>
