---
import Base from '../layouts/Base.astro';
import Isotipo from '../components/Isotipo.astro';
import Icon from '../components/Icon.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CtaBand from '../components/CtaBand.astro';
import ContactForm from '../components/ContactForm.astro';
import PostList from '../components/PostList.astro';
import PostBody from '../components/PostBody.astro';
import { site, partners, areas, steps, testimonials, recognitions, awards, waLink } from '../data/site';
import { sortedPosts, formatDate, readingTime } from '../data/posts';
import { ph, stripBrackets } from '../lib/ph';

const bbox = [site.map.lon - 0.012, site.map.lat - 0.008, site.map.lon + 0.012, site.map.lat + 0.008].join(',');
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${site.map.lat},${site.map.lon}`;
const mapLink = `https://www.openstreetmap.org/?mlat=${site.map.lat}&mlon=${site.map.lon}#map=17/${site.map.lat}/${site.map.lon}`;

---
<Base
  title="Abogados de familia y civil en Ibarra | Estudio Jurídico Mira & Montesdeoca"
  description="Estudio jurídico en Ibarra, Ecuador. Divorcios, pensión de alimentos, tenencia, herencias y contratos. Escríbanos por WhatsApp y agende su consulta."
>
  <SiteHeader />

  <main id="contenido">
    <!-- HERO -->
    <section class="hero indigo" id="top" aria-labelledby="hero-title">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1 id="hero-title">Abogados de familia en Ibarra, a su lado en cada paso.</h1>
          <p class="hero-lede">
            Divorcios, pensión de alimentos, tenencia, herencias y contratos. Le explicamos su caso con
            palabras claras y lo llevamos con usted, de principio a fin.
          </p>
          <div class="hero-actions">
            <a class="btn btn-wa btn-lg" href={waLink()} target="_blank" rel="noopener">
              <Icon name="whatsapp" class="ico" />
              <span>Escríbanos por WhatsApp</span>
            </a>
            <a class="link-thread" href="#consulta">
              Agendar una consulta <Icon name="arrow" class="ico" />
            </a>
          </div>
          <p class="hero-note" set:html={ph('Primera consulta: [condiciones por confirmar]')} />
        </div>
        <div class="hero-mark" aria-hidden="true">
          <div class="woven-m"></div>
        </div>
      </div>
      <div class="weft weft-hero" aria-hidden="true"></div>
    </section>

    <!-- EL ESTUDIO -->
    <section class="section section-l cotton" id="estudio" aria-labelledby="estudio-title">
      <div class="wrap estudio-grid">
        <div class="estudio-intro">
          <h2 id="estudio-title">Dos apellidos, una sola manera de trabajar.</h2>
          <p class="big-p">
            <strong>Mira &amp; Montesdeoca</strong> lleva los apellidos de sus socios fundadores. No es una
            marca detrás de la que se esconde un equipo anónimo: en cada caso, usted sabe quién le atiende y
            habla directamente con su abogado.
          </p>
          <p>
            Nuestro símbolo une dos <em>M</em> —dos cumbres, como las que rodean Ibarra— sobre una balanza.
            Dos personas que sostienen juntas el equilibrio de su caso.
          </p>
          <p class="muted" set:html={ph('Ejercemos en Imbabura desde [año de fundación].')} />
        </div>
        <ul class="partners">
          {partners.map((p) => (
            <li class="partner">
              <div class="ghost ghost-portrait">
                <span class="ghost-tag">Foto profesional</span>
                <span class="ghost-label">Foto de {p.name.replace(/[[\]]/g, '')}</span>
              </div>
              <div class="partner-body">
                <h3 set:html={ph(p.name)} />
                <p class="partner-title" set:html={ph(p.title)} />
                <p class="partner-focus">{p.focus}</p>
                <p class="partner-reg" set:html={ph(p.registry)} />
                <p class="partner-bio" set:html={ph(p.bio)} />
                <a
                  class="link-thread link-dark partner-cta"
                  href={waLink(`Hola, quisiera agendar una consulta con ${stripBrackets(p.name)}.`)}
                  target="_blank"
                  rel="noopener"
                >
                  Escribir a {stripBrackets(p.name)} <Icon name="arrow" class="ico" />
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <div class="weft weft-thin" aria-hidden="true"></div>

    <!-- ÁREAS -->
    <section class="section cotton areas" id="areas" aria-labelledby="areas-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="areas-title">Dos áreas. Las conocemos a fondo.</h2>
          <p>
            Nos dedicamos al derecho de familia y al derecho civil, nada más. Así podemos darle a su caso la
            atención y el conocimiento que necesita.
          </p>
        </div>
        <div class="areas-grid">
          {areas.map((a) => (
            <article class="area" id={`area-${a.id}`}>
              <h3 class="area-name">{a.name}</h3>
              <p class="area-lead">{a.lead}</p>
              <ul class="area-list">
                {a.items.map((i) => <li>{i}</li>)}
              </ul>
              <a
                class="link-thread link-dark"
                href={waLink(`Hola, necesito asesoría en derecho ${a.name.toLowerCase()}.`)}
                target="_blank"
                rel="noopener"
              >
                Consultar sobre {a.name.toLowerCase()} <Icon name="arrow" class="ico" />
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="weft weft-thin" aria-hidden="true"></div>

    <!-- CÓMO TRABAJAMOS -->
    <section class="section section-l indigo proceso" id="proceso" aria-labelledby="proceso-title">
      <div class="wrap proceso-grid">
        <div class="proceso-copy">
          <h2 id="proceso-title">Cómo llevamos su caso.</h2>
          <p class="proceso-lede">
            Un proceso legal no debería ser una caja negra. Así trabajamos con cada cliente, hilo por hilo,
            hasta cerrar su caso.
          </p>
          <ol class="steps">
            {steps.map((s, i) => (
              <li class="step" data-step={i}>
                <span class="step-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="step-weft" aria-hidden="true" style={`--i:${i}`}></span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))}
          </ol>
          <a class="btn btn-wa btn-lg" href={waLink()} target="_blank" rel="noopener">
            <Icon name="whatsapp" class="ico" />
            <span>Empezar por el paso uno</span>
          </a>
        </div>
        <div class="loom-col" aria-hidden="true">
          <div class="loom">
            {steps.map((s, i) => (
              <div class="loom-band" data-band={i} style={`--i:${i}`}>
                <span class="loom-label">{String(i + 1).padStart(2, '0')} · {s.title}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <div class="weft weft-thin" aria-hidden="true"></div>

    <!-- TESTIMONIOS -->
    <section class="section cotton" id="testimonios" aria-labelledby="testimonios-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="testimonios-title">Lo que dicen nuestros clientes.</h2>
          <p class="sample-note">
            <span class="ph">Testimonios de ejemplo</span> Reemplazar por testimonios reales, con autorización
            escrita de cada cliente.
          </p>
        </div>
        <div class="quotes">
          {testimonials.map((t, i) => (
            <figure class={`quote quote-${i}`}>
              <Icon name="quote" class="quote-mark" />
              <blockquote set:html={ph(t.quote)} />
              <figcaption>
                <span class="quote-name" set:html={ph(t.name)} />
                <span class="quote-meta">{t.matter} · {t.place}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <CtaBand
      title="¿Su situación se parece a alguna de estas?"
      text="Cuéntenos su caso. La primera conversación es para escucharle y explicarle sus opciones."
    />

    <!-- RECONOCIMIENTOS -->
    <section class="section section-s cotton recon" aria-labelledby="recon-title">
      <div class="wrap recon-grid">
        <div class="recon-intro">
          <h2 id="recon-title">La confianza de quienes nos eligieron.</h2>
          <p set:html={ph('[Familias y clientes de Imbabura] que han confiado en nosotros. [Más de N] casos acompañados desde [año].')} />
        </div>
        <ul class="awards">
          {awards.map((a) => (
            <li>
              <span class="award-title" set:html={ph(a.title)} />
              <span class="award-meta" set:html={ph(`${a.by} · ${a.year}`)} />
            </li>
          ))}
        </ul>
        <ul class="logo-wall" aria-label="Clientes e instituciones (por confirmar)">
          {recognitions.map((r) => (
            <li class="ghost ghost-logo"><span class="ghost-label">{r.label.replace(/[[\]]/g, '')}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <div class="weft weft-thin" aria-hidden="true"></div>

    <!-- BLOG -->
    <section class="section cotton blog-section" id="blog" aria-labelledby="blog-title" data-blog>
      <div class="wrap">
        <div class="section-head">
          <h2 id="blog-title" tabindex="-1">Guías para entender su caso.</h2>
          <p>
            Artículos breves, en lenguaje claro, sobre las dudas que más escuchamos en la oficina. Ábralos aquí
            mismo, sin salir de la página.
          </p>
        </div>

        <div data-blog-list>
          <PostList headingTag="h3" />
        </div>

        {sortedPosts.map((post, i) => {
          const prev = sortedPosts[i - 1];
          const next = sortedPosts[i + 1];
          return (
            <article class="reader" id={`guia-${post.slug}`} data-reader={post.slug} aria-labelledby={`rt-${post.slug}`} hidden>
              <div class="reader-bar">
                <button class="reader-back" type="button" data-close>
                  <Icon name="arrow" class="ico" /> Todas las guías
                </button>
                <a class="reader-perma" href={`/blog/${post.slug}/`}>Abrir en página aparte</a>
              </div>
              <header class="reader-head indigo">
                <div class="reader-head-inner">
                  <p class="reader-crumb">Guías · {post.category}</p>
                  <h3 class="reader-title" id={`rt-${post.slug}`} tabindex="-1">{post.title}</h3>
                  <p class="page-lede">{post.excerpt}</p>
                  <p class="post-byline">
                    Por <span set:html={ph(post.author)} /> · <time datetime={post.date}>{formatDate(post.date)}</time> ·
                    {readingTime(post)} min de lectura
                  </p>
                </div>
                <div class="weft weft-thin reader-weft" aria-hidden="true"></div>
              </header>
              <div class="reader-body">
                <PostBody post={post} headingTag="h4" idPrefix={`${post.slug}--`} />
              </div>
              <nav class="reader-pager" aria-label="Otras guías">
                {prev ? (
                  <a href={`/blog/${prev.slug}/`} data-open={prev.slug} class="pager-link">
                    <span class="pager-dir">Guía anterior</span>
                    <span class="pager-title">{prev.title}</span>
                  </a>
                ) : <span />}
                {next && (
                  <a href={`/blog/${next.slug}/`} data-open={next.slug} class="pager-link pager-next">
                    <span class="pager-dir">Siguiente guía</span>
                    <span class="pager-title">{next.title}</span>
                  </a>
                )}
              </nav>
            </article>
          );
        })}
      </div>
    </section>

    <!-- CONSULTA -->
    <section class="section section-l indigo consulta" id="consulta" aria-labelledby="consulta-title">
      <div class="wrap consulta-grid">
        <div class="consulta-copy">
          <h2 id="consulta-title">Agende su consulta.</h2>
          <p class="consulta-lede">
            Déjenos sus datos y una frase sobre su caso. Le respondemos en horario de oficina para
            coordinar una cita.
          </p>
          <ol class="consulta-next">
            <li><span><strong>Revisamos su mensaje</strong> y vemos qué abogado del estudio es el indicado.</span></li>
            <li><span><strong>Le contactamos</strong> por WhatsApp o por llamada, como usted prefiera.</span></li>
            <li><span><strong>Agendamos la cita</strong> en la oficina o en línea.</span></li>
          </ol>
          <div class="consulta-direct">
            <p>¿Prefiere hablar ya?</p>
            <a class="link-thread" href={waLink()} target="_blank" rel="noopener">
              <Icon name="whatsapp" class="ico" /> WhatsApp directo
            </a>
            <a class="link-thread" href={site.phoneHref}>
              <Icon name="phone" class="ico" /> <span set:html={ph(site.phoneDisplay)} />
            </a>
          </div>
        </div>
        <ContactForm />
      </div>
    </section>

    <div class="weft weft-thin" aria-hidden="true"></div>

    <!-- UBICACIÓN -->
    <section class="section cotton" id="ubicacion" aria-labelledby="ubicacion-title">
      <div class="wrap ubic-grid">
        <div class="ubic-info">
          <h2 id="ubicacion-title">Estamos en el centro de Ibarra.</h2>
          <p>Le recibimos en nuestra oficina. Para no hacerle esperar, escríbanos antes y reservamos su hora.</p>
          <dl class="contact-list">
            <div>
              <dt><Icon name="pin" class="ico" /> Dirección</dt>
              <dd>
                <span set:html={ph(site.address)} /><br />
                <span set:html={ph(site.addressNote)} /><br />
                {site.city}
              </dd>
            </div>
            <div>
              <dt><Icon name="clock" class="ico" /> Horario</dt>
              <dd>
                {site.hours.map((h) => (
                  <span class="hour-row"><span>{h.days}</span> <span set:html={ph(h.time)} /></span>
                ))}
              </dd>
            </div>
            <div>
              <dt><Icon name="phone" class="ico" /> Teléfono</dt>
              <dd><a href={site.phoneHref} set:html={ph(site.phoneDisplay)} /></dd>
            </div>
            <div>
              <dt><Icon name="mail" class="ico" /> Correo</dt>
              <dd><span set:html={ph(site.email)} /></dd>
            </div>
          </dl>
          <a class="link-thread link-dark" href={mapLink} target="_blank" rel="noopener">
            Abrir en el mapa <Icon name="arrow" class="ico" />
          </a>
        </div>
        <div class="map-frame">
          <iframe
            title="Mapa de la ubicación del estudio en Ibarra"
            src={mapSrc}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <span class="map-tag ph">Ubicación aproximada: centro de Ibarra</span>
        </div>
      </div>
    </section>

    <!-- CIERRE -->
    <section class="close indigo" aria-labelledby="close-title">
      <div class="weft weft-close" aria-hidden="true"></div>
      <div class="wrap close-inner">
        <Isotipo variant="light" class="close-iso" />
        <h2 id="close-title">Cuéntenos qué está pasando. <br />Empezamos por escucharle.</h2>
        <a class="btn btn-wa btn-lg" href={waLink()} target="_blank" rel="noopener">
          <Icon name="whatsapp" class="ico" />
          <span>Escríbanos por WhatsApp</span>
        </a>
        <a class="link-thread" href="#consulta">o llene el formulario de consulta <Icon name="arrow" class="ico" /></a>
        <p class="close-small">Respuesta en horario de oficina. Su consulta es confidencial.</p>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    // Guías: abrir el artículo dentro de la sección del blog, sin salir de la página.
    const blog = document.querySelector<HTMLElement>('[data-blog]');
    if (blog) {
      const list = blog.querySelector<HTMLElement>('[data-blog-list]')!;
      const readers = blog.querySelectorAll<HTMLElement>('[data-reader]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let openSlug: string | null = null;
      const toTop = () => blog.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });

      const open = (slug: string, push = true, scroll = true) => {
        const reader = blog.querySelector<HTMLElement>(`[data-reader="${slug}"]`);
        if (!reader) return false;
        list.hidden = true;
        readers.forEach((r) => (r.hidden = r !== reader));
        reader.classList.remove('is-entering');
        void reader.offsetWidth;
        reader.classList.add('is-entering');
        openSlug = slug;
        if (push) history.pushState({ guia: slug }, '', `#guia-${slug}`);
        if (scroll) reader.scrollIntoView({ behavior: reduced || !push ? 'auto' : 'smooth', block: 'start' });
        reader.querySelector<HTMLElement>('.reader-title')?.focus({ preventScroll: true });
        return true;
      };

      const close = (push = true) => {
        if (!openSlug) return;
        readers.forEach((r) => (r.hidden = true));
        list.hidden = false;
        openSlug = null;
        if (push) history.pushState({}, '', '#blog');
      };

      blog.addEventListener('click', (e) => {
        const ev = e as MouseEvent;
        const target = ev.target as HTMLElement;
        const link = target.closest<HTMLAnchorElement>('a[data-open]');
        if (link && !(ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.button !== 0)) {
          if (open(link.dataset.open!)) e.preventDefault();
          return;
        }
        if (target.closest('[data-close]')) {
          if (history.state?.guia) history.back();
          else { close(false); history.replaceState({}, '', '#blog'); }
          toTop();
          blog.querySelector<HTMLElement>('#blog-title')?.focus({ preventScroll: true });
          return;
        }
        const out = target.closest<HTMLAnchorElement>('a[data-close-to]');
        if (out) {
          e.preventDefault();
          close(false);
          const dest = document.getElementById(out.dataset.closeTo!);
          history.pushState({}, '', `#${out.dataset.closeTo}`);
          dest?.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth' });
        }
      });

      const sync = () => {
        const hash = decodeURIComponent(location.hash.slice(1));
        const m = hash.match(/^guia-(.+)$/);
        if (m) {
          if (openSlug !== m[1]) open(m[1], false);
          return;
        }
        // Un subtítulo de una guía (índice del artículo) abre esa guía y baja hasta él.
        const el = hash ? document.getElementById(hash) : null;
        const reader = el?.closest<HTMLElement>('[data-reader]');
        if (el && reader) {
          if (openSlug !== reader.dataset.reader) open(reader.dataset.reader!, false, false);
          el.scrollIntoView();
          return;
        }
        close(false);
      };
      window.addEventListener('popstate', sync);
      if (location.hash) document.fonts.ready.then(() => requestAnimationFrame(sync));
    }

    // Telar: cada paso que entra en pantalla teje su pasada de trama.
    const bands = document.querySelectorAll<HTMLElement>('[data-band]');
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const i = Number((entry.target as HTMLElement).dataset.step);
          entry.target.classList.add('is-active');
          bands.forEach((b, j) => j <= i && b.classList.add('is-woven'));
        });
      },
      { rootMargin: '0px 0px -40% 0px' }
    );
    document.querySelectorAll('[data-step]').forEach((s) => io.observe(s));
  </script>
</Base>
