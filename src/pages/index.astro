---
import Base from '../layouts/Base.astro';
import Isotipo from '../components/Isotipo.astro';
import Icon from '../components/Icon.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CtaBand from '../components/CtaBand.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, partners, areas, steps, values, faqs, testimonials, gallery, waLink } from '../data/site';
import { ph } from '../lib/ph';

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.mapQuery)}`;
const years = new Date().getFullYear() - site.since;

// Datos de negocio local para buscadores.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: site.name,
  foundingDate: String(site.since),
  telephone: `+${site.whatsapp}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address}, ${site.addressNote}`,
    addressLocality: 'Ibarra',
    addressRegion: 'Imbabura',
    addressCountry: 'EC',
  },
  areaServed: site.cantons,
};
---
<Base
  title="Abogados en Ibarra | Estudio Jurídico Mira & Montesdeoca"
  description="Estudio jurídico en Ibarra desde 2016. La misma persona escucha, estudia, defiende y te explica tu caso. Primera consulta en línea gratis por WhatsApp."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <SiteHeader />

  <main id="contenido">
    <!-- HERO -->
    <section class="hero indigo" id="top" aria-labelledby="hero-title">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1 id="hero-title">La misma persona que te escucha es la que defiende tu caso.</h1>
          <p class="hero-lede">
            Estudio jurídico en Ibarra desde {site.since}. Estudiamos tu caso completo y te explicamos, sin
            tecnicismos, qué está en juego y qué camino conviene.
          </p>
          <div class="hero-actions">
            <a class="btn btn-wa btn-lg" href={waLink()} target="_blank" rel="noopener" data-track="wa-hero">
              <Icon name="whatsapp" class="ico" />
              <span>Cuéntanos tu caso por WhatsApp</span>
            </a>
            <a class="link-thread" href="#consulta">
              Enviar mi consulta <Icon name="arrow" class="ico" />
            </a>
          </div>
          <ul class="hero-facts">
            <li><strong>{site.freeConsult}</strong> <span set:html={ph(site.freeConsultTerms)} /></li>
            <li><strong>{years} años</strong> de experiencia</li>
            <li><strong>Discreción absoluta</strong> en cada conversación</li>
          </ul>
        </div>
        <div class="hero-mark" aria-hidden="true">
          <div class="woven-m"></div>
        </div>
      </div>
      <div class="weft weft-hero" aria-hidden="true"></div>
    </section>

    <!-- CÓMO TRABAJAMOS -->
    <section class="section indigo proceso" id="proceso" aria-labelledby="proceso-title">
      <div class="wrap proceso-grid">
        <div class="proceso-copy">
          <h2 id="proceso-title">Un solo hilo, de principio a fin.</h2>
          <p class="proceso-lede">
            Aquí no hay departamentos que se pasan el expediente. Quien te escucha en la primera conversación
            es quien piensa tu caso, lo defiende y te llama para contarte cómo va.
          </p>
          <ol class="steps">
            {steps.map((s, i) => (
              <li class="step" data-step={i}>
                <span class="step-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="step-weft" aria-hidden="true" style={`--i:${i}`}></span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))}
          </ol>
          <dl class="values">
            {values.map((v) => (
              <div>
                <dt>{v.title}</dt>
                <dd>{v.text}</dd>
              </div>
            ))}
          </dl>
          <a class="btn btn-wa btn-lg" href={waLink()} target="_blank" rel="noopener" data-track="wa-proceso">
            <Icon name="whatsapp" class="ico" />
            <span>Escríbenos por WhatsApp</span>
          </a>
        </div>
        <div class="loom-col" aria-hidden="true">
          <div class="loom">
            {steps.map((s, i) => (
              <div class="loom-band" data-band={i} style={`--i:${i}`}>
                <span class="loom-label">{String(i + 1).padStart(2, '0')} · {s.title}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <div class="weft weft-thin" aria-hidden="true"></div>

    <!-- SERVICIOS -->
    <section class="section cotton servicios" id="servicios" aria-labelledby="servicios-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="servicios-title">Todas las áreas del derecho. Un caso a la vez.</h2>
          <p>
            Te acompañamos en conflictos y trámites que afectan tus derechos o tu patrimonio. Busca tu
            situación o, si no sabes dónde encaja, escríbenos igual.
          </p>
        </div>
        <ul class="area-index">
          {areas.map((a) => (
            <li class="area-row">
              <h3 class="area-row-name">{a.name}</h3>
              <p class="area-row-items">{a.items}</p>
              <a
                class="link-thread link-dark"
                href={waLink(`Hola, vengo de la página web. Necesito asesoría en ${a.name.toLowerCase()}.`)}
                target="_blank"
                rel="noopener"
                data-track="wa-area"
                aria-label={`Consultar sobre ${a.name} por WhatsApp`}
              >
                Consultar <Icon name="arrow" class="ico" />
              </a>
            </li>
          ))}
        </ul>
        <p class="area-note">
          <span class="ph">Áreas por confirmar con los socios</span> Sin precios publicados: los honorarios se
          conversan en la primera consulta.
        </p>
      </div>
    </section>

    <div class="weft weft-thin" aria-hidden="true"></div>

    <!-- NOSOTROS Y EQUIPO -->
    <section class="section cotton" id="estudio" aria-labelledby="estudio-title">
      <div class="wrap estudio-grid">
        <div class="estudio-intro">
          <h2 id="estudio-title">En Ibarra desde {site.since}.</h2>
          <p class="big-p">
            <strong>Mira &amp; Montesdeoca</strong> nació en {site.since}, cuando su primer socio empezó este
            proyecto. Hoy son dos socios con un mismo método: leer tu situación completa, entenderla en su
            contexto y hacerse cargo de ella.
          </p>
          <p>
            Nuestro símbolo une dos <em>M</em>, dos cumbres como las que rodean Ibarra, sobre una balanza.
            Atendemos en Ibarra y en los cantones vecinos: {site.cantons.slice(1).join(', ')}.
          </p>
          <p class="estudio-quote">«Quien nos elige no está comprando promesas; está poniendo su caso en manos de alguien que se hace cargo».</p>
        </div>
        <ul class="partners">
          {partners.map((p) => (
            <li class="partner">
              <div class="ghost ghost-portrait">
                <span class="ghost-tag">Foto profesional</span>
                <span class="ghost-label">Foto de {p.name}</span>
              </div>
              <div class="partner-body">
                <h3>{p.name}</h3>
                <p class="partner-title">{p.title}</p>
                <p class="partner-reg" set:html={ph(p.degree)} />
                <p class="partner-bio" set:html={ph(p.bio)} />
                <a
                  class="link-thread link-dark partner-cta"
                  href={waLink(`Hola, vengo de la página web. Quisiera hablar con ${p.name}.`)}
                  target="_blank"
                  rel="noopener"
                  data-track="wa-socio"
                >
                  Escribir a {p.name.split(' ')[0]} <Icon name="arrow" class="ico" />
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <div class="weft weft-thin" aria-hidden="true"></div>

    <!-- TESTIMONIOS -->
    <section class="section cotton" id="testimonios" aria-labelledby="testimonios-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="testimonios-title">Lo que dicen quienes nos eligieron.</h2>
          <p class="sample-note">
            <span class="ph">Testimonios de ejemplo</span> Se publicarán solo testimonios reales, con
            autorización escrita de cada cliente.
          </p>
        </div>
        <div class="quotes">
          {testimonials.map((t, i) => (
            <figure class={`quote quote-${i}`}>
              <Icon name="quote" class="quote-mark" />
              <blockquote set:html={ph(t.quote)} />
              <figcaption>
                <span class="quote-name" set:html={ph(t.name)} />
                <span class="quote-meta">{t.matter} · {t.place}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- GALERÍA -->
    <section class="section cotton galeria" id="galeria" aria-labelledby="galeria-title">
      <div class="wrap">
        <h2 id="galeria-title" class="galeria-title">El despacho.</h2>
        <ul class="gallery">
          {gallery.map((g) => (
            <li class={`ghost ghost-photo g-${g.ratio}`}>
              <span class="ghost-tag">Foto profesional</span>
              <span class="ghost-label">{g.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <CtaBand
      title="¿No sabes por dónde empezar?"
      text={`Cuéntanos tu situación por WhatsApp. ${site.freeConsult.charAt(0).toUpperCase() + site.freeConsult.slice(1).toLowerCase()}.`}
    />

    <!-- PREGUNTAS FRECUENTES -->
    <section class="section cotton faq" id="preguntas" aria-labelledby="faq-title">
      <div class="wrap faq-grid">
        <div class="faq-intro">
          <h2 id="faq-title">Lo que más nos preguntan.</h2>
          <p>Respuestas generales para orientarte. Tu caso concreto lo revisamos contigo en la primera consulta.</p>
          <p class="faq-note"><span class="ph">Respuestas en borrador</span> Validar con los socios antes de publicar.</p>
          <a class="btn btn-solid" href={waLink('Hola, vengo de la página web. Tengo una duda sobre mi caso.')} target="_blank" rel="noopener" data-track="wa-faq">
            <Icon name="whatsapp" class="ico" />
            <span>¿Tienes otra duda? Escríbenos</span>
          </a>
        </div>
        <div class="faq-list">
          {faqs.map((f, i) => (
            <details class="faq-item" name="faq">
              <summary>
                <span class="faq-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="faq-q">{f.q}</span>
                <span class="faq-toggle" aria-hidden="true"></span>
              </summary>
              <p class="faq-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <div class="weft weft-thin" aria-hidden="true"></div>

    <!-- CONSULTA -->
    <section class="section indigo consulta" id="consulta" aria-labelledby="consulta-title">
      <div class="wrap consulta-grid">
        <div class="consulta-copy">
          <h2 id="consulta-title">Empieza con tu primera consulta gratis.</h2>
          <p class="consulta-lede">
            Déjanos tus datos y una frase sobre tu caso. Te respondemos para coordinar la consulta en línea.
          </p>
          <ol class="consulta-next">
            <li><span><strong>Nos escribes</strong> por WhatsApp o con este formulario.</span></li>
            <li><span><strong>Tienes tu primera consulta en línea gratis</strong> con el abogado que llevará tu caso. <span set:html={ph(site.freeConsultTerms)} /></span></li>
            <li><span><strong>Te explicamos la estrategia</strong>, los costos y los tiempos antes de decidir.</span></li>
          </ol>
          <div class="consulta-direct">
            <p>¿Prefieres escribir directo?</p>
            <a class="link-thread" href={waLink()} target="_blank" rel="noopener" data-track="wa-consulta">
              <Icon name="whatsapp" class="ico" /> {site.whatsappDisplay}
            </a>
          </div>
        </div>
        <ContactForm />
      </div>
    </section>

    <div class="weft weft-thin" aria-hidden="true"></div>

    <!-- UBICACIÓN -->
    <section class="section cotton" id="ubicacion" aria-labelledby="ubicacion-title">
      <div class="wrap ubic-grid">
        <div class="ubic-info">
          <h2 id="ubicacion-title">Estamos en el centro de Ibarra.</h2>
          <p>Te recibimos en el despacho. Para no hacerte esperar, escríbenos antes y reservamos tu hora.</p>
          <dl class="contact-list">
            <div>
              <dt><Icon name="pin" class="ico" /> Dirección</dt>
              <dd>{site.address}<br />{site.addressNote}<br />{site.city}</dd>
            </div>
            <div>
              <dt><Icon name="clock" class="ico" /> Horario</dt>
              <dd>
                {site.hours.map((h) => (
                  <span class="hour-row"><span>{h.days}</span> <span set:html={ph(h.time)} /></span>
                ))}
              </dd>
            </div>
            <div>
              <dt><Icon name="whatsapp" class="ico" /> WhatsApp</dt>
              <dd><a href={waLink()} target="_blank" rel="noopener" data-track="wa-ubicacion">{site.whatsappDisplay}</a></dd>
            </div>
            <div>
              <dt><Icon name="mail" class="ico" /> Correo</dt>
              <dd><span set:html={ph(site.email)} /></dd>
            </div>
          </dl>
          <a class="link-thread link-dark" href={mapLink} target="_blank" rel="noopener" data-track="mapa">
            Abrir en Google Maps <Icon name="arrow" class="ico" />
          </a>
        </div>
        <div class="map-frame">
          <iframe
            title="Mapa: Calle Bolívar y Oviedo, Ibarra"
            src={mapSrc}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- CIERRE -->
    <section class="close indigo" aria-labelledby="close-title">
      <div class="weft weft-close" aria-hidden="true"></div>
      <div class="wrap close-inner">
        <Isotipo variant="light" class="close-iso" />
        <h2 id="close-title">Un problema legal no se parece a ningún otro. <br />Tu defensa tampoco debería.</h2>
        <a class="btn btn-wa btn-lg" href={waLink()} target="_blank" rel="noopener" data-track="wa-cierre">
          <Icon name="whatsapp" class="ico" />
          <span>Quiero mi primera consulta gratis</span>
        </a>
        <a class="link-thread" href="#consulta">o envía tu consulta con el formulario <Icon name="arrow" class="ico" /></a>
        <p class="close-small">Discreción absoluta: lo que nos cuentas queda entre tú y tu abogado.</p>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    // Telar: cada paso que entra en pantalla teje su pasada de trama.
    const bands = document.querySelectorAll<HTMLElement>('[data-band]');
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const i = Number((entry.target as HTMLElement).dataset.step);
          entry.target.classList.add('is-active');
          bands.forEach((b, j) => j <= i && b.classList.add('is-woven'));
        });
      },
      { rootMargin: '0px 0px -40% 0px' }
    );
    document.querySelectorAll('[data-step]').forEach((s) => io.observe(s));
  </script>
</Base>
