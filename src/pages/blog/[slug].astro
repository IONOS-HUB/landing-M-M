---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CtaBand from '../../components/CtaBand.astro';
import { posts, sortedPosts, formatDate, readingTime, slugify, type Post } from '../../data/posts';
import { waLink } from '../../data/site';
import { ph } from '../../lib/ph';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const toc = post.body.filter((b): b is { h2: string } => 'h2' in b).map((b) => ({ id: slugify(b.h2), text: b.h2 }));
const related = sortedPosts.filter((p) => p.slug !== post.slug && p.category === post.category).slice(0, 2);
const others = related.length < 2
  ? [...related, ...sortedPosts.filter((p) => p.slug !== post.slug && !related.includes(p))].slice(0, 2)
  : related;
const consultMsg = `Hola, leí la guía «${post.title}» y quisiera una consulta sobre mi caso.`;
---
<Base title={`${post.title} | Blog Mira & Montesdeoca`} description={post.excerpt}>
  <SiteHeader current="/blog/" />

  <main id="contenido">
    <header class="page-head post-head indigo">
      <div class="wrap page-head-inner">
        <nav class="crumbs" aria-label="Ruta">
          <a href="/blog/">Blog</a>
          <span aria-hidden="true">/</span>
          <span>{post.category}</span>
        </nav>
        <h1>{post.title}</h1>
        <p class="page-lede">{post.excerpt}</p>
        <p class="post-byline">
          Por <span set:html={ph(post.author)} /> · <time datetime={post.date}>{formatDate(post.date)}</time> ·
          {readingTime(post)} min de lectura
        </p>
      </div>
      <div class="weft weft-hero" aria-hidden="true"></div>
    </header>

    <div class="section cotton">
      <div class="wrap article-grid">
        <article class="prose">
          {post.body.map((b) =>
            'h2' in b ? <h2 id={slugify(b.h2)}>{b.h2}</h2>
            : 'p' in b ? <p>{b.p}</p>
            : 'ul' in b ? <ul>{b.ul.map((li) => <li>{li}</li>)}</ul>
            : <aside class="prose-note"><p>{b.note}</p></aside>
          )}
          <p class="prose-disclaimer">
            Este artículo es información general y no reemplaza la asesoría de un abogado para su caso concreto.
          </p>
        </article>

        <aside class="article-aside">
          <div class="aside-sticky">
            {toc.length > 0 && (
              <nav class="toc" aria-label="En este artículo">
                <p class="toc-title">En este artículo</p>
                <ol>
                  {toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}
                </ol>
              </nav>
            )}
            <div class="aside-cta">
              <p class="aside-cta-title">¿Está pasando por esto?</p>
              <p>Le explicamos qué opciones tiene en su caso.</p>
              <a class="btn btn-solid" href={waLink(consultMsg)} target="_blank" rel="noopener">
                <Icon name="whatsapp" class="ico" />
                <span>Consultar por WhatsApp</span>
              </a>
              <a class="link-thread link-dark" href="/#consulta">Agendar una consulta <Icon name="arrow" class="ico" /></a>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <div class="weft weft-thin" aria-hidden="true"></div>

    <section class="section cotton related" aria-labelledby="related-title">
      <div class="wrap">
        <h2 id="related-title" class="related-title">Siga leyendo</h2>
        <ul class="post-list">
          {others.map((p) => (
            <li class="post-item">
              <p class="post-cat" data-cat={p.category}>{p.category}</p>
              <div>
                <h3><a href={`/blog/${p.slug}/`}>{p.title}</a></h3>
                <p class="post-excerpt">{p.excerpt}</p>
              </div>
              <p class="post-meta post-meta-split"><span>{formatDate(p.date)}</span> <span>{readingTime(p)} min de lectura</span></p>
            </li>
          ))}
        </ul>
        <a class="link-thread link-dark" href="/blog/">Ver todas las guías <Icon name="arrow" class="ico" /></a>
      </div>
    </section>

    <CtaBand title="Hablemos de su caso." text="La primera conversación es para escucharle." message={consultMsg} />
  </main>

  <SiteFooter />
</Base>
