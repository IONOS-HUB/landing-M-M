---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CtaBand from '../../components/CtaBand.astro';
import PostBody from '../../components/PostBody.astro';
import { posts, sortedPosts, formatDate, readingTime, type Post } from '../../data/posts';
import { ph } from '../../lib/ph';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const related = sortedPosts.filter((p) => p.slug !== post.slug && p.category === post.category).slice(0, 2);
const others = related.length < 2
  ? [...related, ...sortedPosts.filter((p) => p.slug !== post.slug && !related.includes(p))].slice(0, 2)
  : related;
const consultMsg = `Hola, leí la guía «${post.title}» y quisiera una consulta sobre mi caso.`;
---
<Base title={`${post.title} | Blog Mira & Montesdeoca`} description={post.excerpt}>
  <SiteHeader current="/#blog" />

  <main id="contenido">
    <header class="page-head post-head indigo">
      <div class="wrap page-head-inner">
        <nav class="crumbs" aria-label="Ruta">
          <a href="/#blog">Guías</a>
          <span aria-hidden="true">/</span>
          <span>{post.category}</span>
        </nav>
        <h1>{post.title}</h1>
        <p class="page-lede">{post.excerpt}</p>
        <p class="post-byline">
          Por <span set:html={ph(post.author)} /> · <time datetime={post.date}>{formatDate(post.date)}</time> ·
          {readingTime(post)} min de lectura
        </p>
      </div>
      <div class="weft weft-hero" aria-hidden="true"></div>
    </header>

    <div class="section cotton">
      <div class="wrap">
        <PostBody post={post} />
      </div>
    </div>

    <div class="weft weft-thin" aria-hidden="true"></div>

    <section class="section cotton related" aria-labelledby="related-title">
      <div class="wrap">
        <h2 id="related-title" class="related-title">Siga leyendo</h2>
        <ul class="post-list">
          {others.map((p) => (
            <li class="post-item">
              <p class="post-cat" data-cat={p.category}>{p.category}</p>
              <div>
                <h3><a href={`/blog/${p.slug}/`}>{p.title}</a></h3>
                <p class="post-excerpt">{p.excerpt}</p>
              </div>
              <p class="post-meta post-meta-split"><span>{formatDate(p.date)}</span> <span>{readingTime(p)} min de lectura</span></p>
            </li>
          ))}
        </ul>
        <a class="link-thread link-dark" href="/#blog">Ver todas las guías <Icon name="arrow" class="ico" /></a>
      </div>
    </section>

    <CtaBand title="Hablemos de su caso." text="La primera conversación es para escucharle." message={consultMsg} />
  </main>

  <SiteFooter />
</Base>
